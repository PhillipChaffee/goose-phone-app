 "settings": "<div class=\"app\"><header class=\"topbar\"><button class=\"icon-btn menu\" data-dioxus-id=\"51\"><svg class=\"icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h11M4 17h16\"></path></svg></button><h1 class=\"title\">Settings</h1></header><main class=\"scroll settings\"><section class=\"card\"><h2>Server</h2><label class=\"field-label\">Server URL</label><input class=\"field\" type=\"url\" placeholder=\"https://goose-box.tailnet-name.ts.net\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\" data-dioxus-id=\"41\"><p class=\"hint\">Over Tailscale: use your server's MagicDNS name. With <code>tailscale serve</code> fronting goose this is an https:// URL; a plain <code>goose serve</code> on the tailnet is http://host:3284.</p><label class=\"field-label\">Secret key</label><input class=\"field\" type=\"password\" placeholder=\"GOOSE_SERVER__SECRET_KEY value\" autocapitalize=\"off\" autocomplete=\"off\" data-dioxus-id=\"40\"><label class=\"field-label\">TLS certificate fingerprint (optional)</label><input class=\"field\" type=\"text\" placeholder=\"AA:BB:CC:\u2026\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\" data-dioxus-id=\"42\"><p class=\"hint\">Paste the GOOSED_CERT_FINGERPRINT line goose prints at startup to pin a self-signed certificate. Leave empty for real certificates (tailscale serve).</p></section><section class=\"card\"><h2>Agent</h2><label class=\"field-label\">Working directory on the server</label><input class=\"field\" type=\"text\" placeholder=\"/home/you/projects\" autocapitalize=\"off\" autocomplete=\"off\" spellcheck=\"false\" data-dioxus-id=\"43\"><p class=\"hint\">Absolute path on the goose server; new chats start here.</p></section><section class=\"card\"><h2>Code agents</h2><label class=\"field-label\">Code server URL</label><input class=\"field\" type=\"url\" placeholder